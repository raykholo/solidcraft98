Attribute VB_Name = "modIcons"
' modIcons - toolbar art, hand-drawn one pixel at a time like it's 1998.
'
' Every icon is 16 rows of 16 characters. A hex digit is a QBColor index
' (the classic 16-colour palette), "." is see-through. PaintIcon draws one
' into a PictureBox at startup, so the project has no binary files.
' tools/pixpng.py renders a preview sheet.
Option Explicit

Public Const ICON_MASK As Long = &HFF00FF   ' magenta, never used in the art

Private mRows(0 To 15) As String
Private mCount As Integer

Private Sub R(ByVal s As String)
    If mCount <= 15 Then mRows(mCount) = s
    mCount = mCount + 1
End Sub

Public Function IconKeys() As String
    IconKeys = "New Open Save SketchRect SketchCircle Extrude Revolve Hole Orbit Shaded ZoomFit Regen Turbo"
End Function

' bTransparent skips the see-through pixels; otherwise they're painted ICON_MASK.
' The same icon at s times the size, for Cal and friends.
Public Sub PaintIconScaled(ByVal pic As PictureBox, ByVal sKey As String, ByVal x0 As Long, ByVal y0 As Long, ByVal s As Long)
    Dim x As Long, y As Long, ch As String
    LoadRows sKey
    For y = 0 To 15
        For x = 0 To 15
            ch = Mid$(mRows(y), x + 1, 1)
            If ch <> "." And ch <> "" Then
                pic.Line (x0 + x * s, y0 + y * s)-(x0 + x * s + s - 1, y0 + y * s + s - 1), QBColor(CInt("&H" & ch)), BF
            End If
        Next x
    Next y
End Sub

' Returns the icon's 16 rows, for code that wants the pixels (the GIF writer).
Public Function IconRows(ByVal sKey As String) As String()
    Dim r(0 To 15) As String, i As Integer
    LoadRows sKey
    For i = 0 To 15
        r(i) = mRows(i)
    Next i
    IconRows = r
End Function

Public Sub PaintIcon(ByVal pic As PictureBox, ByVal sKey As String, ByVal x0 As Long, ByVal y0 As Long, _
                     Optional ByVal bTransparent As Boolean = False)
    Dim x As Long, y As Long, ch As String
    LoadRows sKey
    For y = 0 To 15
        For x = 0 To 15
            ch = Mid$(mRows(y), x + 1, 1)
            If ch = "." Or ch = "" Then
                If Not bTransparent Then pic.PSet (x0 + x, y0 + y), ICON_MASK
            Else
                pic.PSet (x0 + x, y0 + y), QBColor(CInt("&H" & ch))
            End If
        Next x
    Next y
End Sub

